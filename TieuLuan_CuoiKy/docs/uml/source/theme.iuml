' Shared, local-only styling for all project UML diagrams.
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam titleFontSize 22
skinparam titleFontColor #0F172A
skinparam titleFontStyle bold
skinparam shadowing false
skinparam roundcorner 10
skinparam ArrowColor #475569
skinparam ArrowFontColor #334155
skinparam ArrowFontSize 12
skinparam ArrowThickness 1.2
skinparam nodesep 35
skinparam ranksep 40
skinparam padding 8
skinparam dpi 150
skinparam packageStyle rectangle
skinparam packageBackgroundColor #F8FAFC
skinparam packageBorderColor #CBD5E1
skinparam componentStyle uml2
skinparam componentBackgroundColor #EFF6FF
skinparam componentBorderColor #2563EB
skinparam classBackgroundColor #EFF6FF
skinparam classBorderColor #2563EB
skinparam classAttributeIconSize 0
skinparam usecaseBackgroundColor #EFF6FF
skinparam usecaseBorderColor #2563EB
skinparam actorBorderColor #334155
skinparam noteBackgroundColor #FFFBEB
skinparam noteBorderColor #D97706
skinparam noteFontColor #78350F
skinparam activityBackgroundColor #EFF6FF
skinparam activityBorderColor #2563EB
skinparam activityDiamondBackgroundColor #FFF7ED
skinparam activityDiamondBorderColor #D97706
skinparam partitionBackgroundColor #F8FAFC
skinparam partitionBorderColor #CBD5E1
skinparam sequenceParticipantBackgroundColor #EFF6FF
skinparam sequenceParticipantBorderColor #2563EB
skinparam sequenceLifeLineBorderColor #94A3B8
skinparam sequenceGroupBackgroundColor #F8FAFC
skinparam sequenceGroupBorderColor #94A3B8
skinparam sequenceMessageAlign center
skinparam databaseBackgroundColor #ECFDF5
skinparam databaseBorderColor #059669
skinparam artifactBackgroundColor #F8FAFC
skinparam artifactBorderColor #64748B
skinparam nodeBackgroundColor #F8FAFC
skinparam nodeBorderColor #64748B
skinparam footerFontSize 11
skinparam footerFontColor #64748B
footer TieuLuan_CuoiKy | Đối chiếu mã nguồn ngày 06/11/2026
